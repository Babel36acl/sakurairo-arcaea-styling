---
import { render, type CollectionEntry } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PostMetadata from "@components/layout/PostMeta.astro";
import { siteConfig } from "@/config/siteConfig";

type LegacyEntry = CollectionEntry<"posts"> | CollectionEntry<"pages">;

interface Props {
	entry: LegacyEntry;
	kind: "post" | "page";
}

const { entry, kind } = Astro.props;
const { Content, headings } = await render(entry);
const canonicalPath = entry.data.permalink || Astro.url.pathname;
const isPost = kind === "post";
const post = isPost ? (entry as CollectionEntry<"posts">) : undefined;
const postData = post?.data;
---

<MainGridLayout
	title={entry.data.title}
	description={entry.data.description || entry.data.title}
	headings={headings}
	setOGTypeArticle={isPost}
	postSlug={isPost ? entry.id : undefined}
>
	<article class="card-base relative mb-6 overflow-hidden rounded-(--radius-large) p-6 md:p-9">
		<header class="mb-8 border-b border-(--line-divider) pb-6">
			<div class="mb-3 text-sm font-medium uppercase tracking-[0.16em] text-(--primary)">
				{isPost ? "Babel36acl / Article" : "Babel36acl / Page"}
			</div>
			<h1 class="mb-4 text-3xl font-bold leading-tight text-(--btn-content) md:text-5xl">
				{entry.data.title}
			</h1>
			{isPost && postData && (
				<PostMetadata
					published={postData.published}
					updated={postData.updated}
					category={postData.category || undefined}
					tags={postData.tags}
					id={entry.id}
					customPath={canonicalPath}
					pinned={postData.pinned}
				/>
			)}
			{!isPost && (
				<p class="text-sm text-(--content-meta)">
					{entry.data.updated ? `更新于 ${entry.data.updated.toISOString().slice(0, 10)}` : ""}
				</p>
			)}
		</header>

		<Markdown class="markdown-content">
			<Content />
		</Markdown>
	</article>

	{isPost && postData?.comment !== false && <Comment post={post} customPath={canonicalPath} />}

	<div class="sr-only" data-site-origin={siteConfig.site_url} data-canonical-path={canonicalPath}></div>
</MainGridLayout>
