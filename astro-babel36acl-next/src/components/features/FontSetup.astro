---
/**
 * FontSetup.astro
 *
 * 使用 Astro Font API（<Font /> 组件）统一管理字体加载。
 * 字体定义在 fontConfig.ts 的 fonts 数组中配置，
 * 本组件负责渲染 <Font /> 标签并设置 body 字体和区域覆盖 CSS 变量。
 *
 * 字体的 fallback 由各字体定义中的 fallbacks 字段控制（Astro Font API 处理），
 */
import { Font } from "astro:assets";
import { fontConfig } from "@/config";
import { collectUsedFontCssVars } from "@/utils/fontHelper";

// 使用共享的工具函数收集所有需要加载的 CSS 变量名（selected + 各区域字体，去重）
// enable=false 时返回空集，不会加载任何字体
const allCssVars = fontConfig.enable
	? collectUsedFontCssVars(fontConfig)
	: new Set<string>();

// 统一解析 selected 为数组（用于后续 body font-family 和 preload 判断）
const selectedIds: string[] =
	fontConfig.enable && fontConfig.selected
		? Array.isArray(fontConfig.selected)
			? fontConfig.selected
			: [fontConfig.selected]
		: [];

// 生成 body 的 font-family 值
// 每个字体的 fallback 由其在 fonts 中的 fallbacks 字段控制
// 这里只拼接 CSS 变量引用，末尾加系统字体作为最终保底
const SYSTEM_FONT_STACK =
	"system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
// 代码字体的系统保底栈，codeFont 没配置或字体加载失败时用它，保证行内代码/代码块始终是等宽字体
const MONO_FONT_STACK =
	'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace';
const selectedFontVars = selectedIds.filter((v) => v !== "system");
const bodyFontFamily =
	selectedFontVars.length > 0
		? [...selectedFontVars.map((v) => `var(${v})`), SYSTEM_FONT_STACK].join(
				", ",
			)
		: SYSTEM_FONT_STACK;

// 各区域字体 CSS 变量值
const bannerTitleFontVar = fontConfig.enable
	? fontConfig.bannerTitleFont || ""
	: "";
const bannerSubtitleFontVar = fontConfig.enable
	? fontConfig.bannerSubtitleFont || ""
	: "";
const navbarTitleFontVar = fontConfig.enable
	? fontConfig.navbarTitleFont || ""
	: "";
const codeFontVar = fontConfig.enable ? fontConfig.codeFont || "" : "";
// --font-code 由 fontConfig.codeFont 决定，行内代码和代码块统一引用它
// 末尾始终带 MONO_FONT_STACK 保底，避免 codeFont 为空时 var() 解析失败导致字体回退到正文字体
const codeFontFamily = codeFontVar
	? `var(${codeFontVar}, ${MONO_FONT_STACK})`
	: MONO_FONT_STACK;
---

<!-- Astro Font API: 自动下载、缓存并生成优化的 @font-face -->
{Array.from(allCssVars).map((cssVar) => (
  <Font
    cssVariable={cssVar as any}
    preload={selectedFontVars.includes(cssVar)}
  />
))}

<!-- 区域字体 CSS 变量 + body 字体 -->
<!-- --font-code 无条件输出，即使关闭自定义字体，行内代码和代码块也要保持等宽字体 -->
<style
  set:html={`
  :root {
    --font-code: ${codeFontFamily};
    ${bannerTitleFontVar ? `--font-banner-title: var(${bannerTitleFontVar}, inherit);` : ""}
    ${bannerSubtitleFontVar ? `--font-banner-subtitle: var(${bannerSubtitleFontVar}, inherit);` : ""}
    ${navbarTitleFontVar ? `--font-navbar-title: var(${navbarTitleFontVar}, inherit);` : ""}
  }

  ${
		fontConfig.enable &&
		(bannerTitleFontVar ||
			bannerSubtitleFontVar ||
			navbarTitleFontVar ||
			selectedFontVars.length > 0)
			? `body {
      font-family: ${bodyFontFamily};
    }`
			: ""
	}
`}
/>

<style is:global>
  @font-face {
    font-family: "Font Awesome 6 Free";
    font-style: normal;
    font-weight: 400;
    font-display: block;
    src: url("/assets/fonts/fa-regular-400.woff2") format("woff2");
  }

  @font-face {
    font-family: "Font Awesome 6 Free";
    font-style: normal;
    font-weight: 900;
    font-display: block;
    src: url("/assets/fonts/fa-solid-900.woff2") format("woff2");
  }

  @font-face {
    font-family: "Zen Old Mincho";
    font-style: normal;
    font-weight: 700;
    font-display: fallback;
    src: url("/assets/fonts/ZenOldMincho-Bold.ttf") format("truetype");
  }

  .fa,
  .fa-brands,
  .fa-regular,
  .fa-solid {
    -moz-osx-font-smoothing: grayscale;
    -webkit-font-smoothing: antialiased;
    display: inline-block;
    font-style: normal;
    font-variant: normal;
    line-height: 1;
    text-rendering: auto;
  }

  .fa-regular,
  .fa-solid {
    font-family: "Font Awesome 6 Free";
  }

  .fa-regular {
    font-weight: 400;
  }

  .fa-solid {
    font-weight: 900;
  }

  .fa-regular::before,
  .fa-solid::before {
    content: var(--fa);
  }

  .fa-clock { --fa: "\f017"; }
  .fa-eye { --fa: "\f06e"; }
  .fa-comment { --fa: "\f075"; }
  .fa-folder { --fa: "\f07b"; }
  .fa-pen-to-square { --fa: "\f044"; }
  .fa-hourglass { --fa: "\f254"; }
  .fa-bars-staggered { --fa: "\f550"; }
  .fa-bars { --fa: "\f0c9"; }
  .fa-magnifying-glass { --fa: "\f002"; }
  .fa-dice { --fa: "\f522"; }
  .fa-bookmark { --fa: "\f02e"; }
  .fa-circle-user { --fa: "\f2bd"; }
  .fa-quote-left { --fa: "\f10d"; }
  .fa-quote-right { --fa: "\f10e"; }
  .fa-laptop { --fa: "\f109"; }
  .fa-users { --fa: "\f0c0"; }
  .fa-medal { --fa: "\f5a2"; }
  .fa-file-lines { --fa: "\f15c"; }
  .fa-bullhorn { --fa: "\f0a1"; }
  .fa-user-clock { --fa: "\f4fd"; }
  .fa-caret-up { --fa: "\f0d8"; }
  .fa-compass-drafting { --fa: "\f568"; }
  .fa-sun { --fa: "\f185"; }
  .fa-moon { --fa: "\f186"; }
  .fa-heart { --fa: "\f004"; }
  .fa-star { --fa: "\f005"; }
  .fa-lemon { --fa: "\f094"; }
  .fa-font { --fa: "\f031"; }
  .fa-bold { --fa: "\f032"; }

  @font-face {
    font-family: "Zen Old Mincho";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/assets/fonts/ZenOldMincho-Regular.ttf") format("truetype");
  }

  /* Sakurairo 首页的正文、导航和 Hero 共用同一套衬线字体。 */
  body.is-home {
    font-family: "Zen Old Mincho" !important;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
  }

  body.is-home #content-panel,
  body.is-home #content-panel-inner {
    font-family: "Zen Old Mincho";
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
  }

  body.is-home #navbar,
  body.is-home #navbar a,
  body.is-home #navbar nav {
    font-family: "Zen Old Mincho" !important;
    font-weight: 300;
  }
</style>

<script>
  // 字体加载完成事件
  if (document.fonts && typeof document.fonts.ready !== "undefined") {
    document.fonts.ready
      .then(() => {
        document.dispatchEvent(new CustomEvent("fontsLoaded"));
      })
      .catch((error) => {
        console.warn("Font loading failed:", error);
      });
  }
</script>
