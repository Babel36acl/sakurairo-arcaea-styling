<!-- Sakurairo app.js 的输入/选区粒子 Canvas。它不是樱花层，触发条件是 input 事件。 -->
<script>
  if (!window.__selectionParticlesInit) {
    window.__selectionParticlesInit = true;

    const canvas = document.createElement("canvas");
    canvas.id = "selection-particles";
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    canvas.style.cssText = "position:fixed;top:0;left:0;pointer-events:none;z-index:999999";
    document.body.appendChild(canvas);

    const context = canvas.getContext("2d");
    if (context) {
      const particles: Array<{
        x: number;
        y: number;
        alpha: number;
        color: string;
        velocity: { x: number; y: number };
      }> = [];
      let cursor = 0;
      let running = false;
      let colorful = true;
      const maxParticles = 500;

      const randomBetween = (min: number, max: number) => Math.random() * (max - min) + min;

      const getColor = (source: Element | null) => {
        if (colorful) {
          const hue = randomBetween(0, 360);
          return `hsla(${randomBetween(hue - 10, hue + 10)}, 100%, ${randomBetween(50, 80)}%, 1)`;
        }
        return source ? getComputedStyle(source).color : "transparent";
      };

      const getCaretPosition = (element: HTMLInputElement | HTMLTextAreaElement) => {
        const rect = element.getBoundingClientRect();
        const value = element.value.slice(0, element.selectionEnd ?? element.value.length);
        const measure = document.createElement("span");
        const style = getComputedStyle(element);
        measure.style.cssText = [
          "position:absolute",
          "visibility:hidden",
          "white-space:pre",
          `font:${style.font}`,
          `letter-spacing:${style.letterSpacing}`,
        ].join(";");
        measure.textContent = value || "";
        document.body.appendChild(measure);
        const width = measure.getBoundingClientRect().width;
        measure.remove();
        return { x: rect.left + Math.min(width, rect.width - 4), y: rect.top + rect.height / 2, color: getColor(element) };
      };

      const getOrigin = () => {
        const active = document.activeElement;
        if (active instanceof HTMLTextAreaElement || active instanceof HTMLInputElement && active.type === "text" || active instanceof HTMLInputElement && active.type === "search") {
          return getCaretPosition(active);
        }

        const selection = window.getSelection();
        if (selection?.rangeCount) {
          const range = selection.getRangeAt(0);
          const node = range.startContainer.nodeType === Node.TEXT_NODE ? range.startContainer.parentElement : range.startContainer as Element;
          const rect = range.getBoundingClientRect();
          if (node && rect.width + rect.height > 0) return { x: rect.left, y: rect.top, color: getColor(node) };
        }
        return { x: 0, y: 0, color: "transparent" };
      };

      const animate = () => {
        running = true;
        context.clearRect(0, 0, canvas.width, canvas.height);
        let active = false;
        const viewport = canvas.getBoundingClientRect();
        for (const particle of particles) {
          if (particle.alpha <= 0.1) continue;
          active = true;
          particle.velocity.y += 0.075;
          particle.x += particle.velocity.x;
          particle.y += particle.velocity.y;
          particle.alpha *= 0.96;
          context.globalAlpha = particle.alpha;
          context.fillStyle = particle.color;
          context.fillRect(Math.round(particle.x - 1.5) - viewport.left, Math.round(particle.y - 1.5) - viewport.top, 3, 3);
        }
        context.globalAlpha = 1;
        if (active) requestAnimationFrame(animate);
        else running = false;
      };

      const emit = () => {
        const origin = getOrigin();
        const count = 5 + Math.round(10 * Math.random());
        for (let index = 0; index < count; index += 1) {
          particles[cursor] = {
            x: origin.x,
            y: origin.y,
            alpha: 1,
            color: origin.color,
            velocity: { x: 2 * Math.random() - 1, y: 2 * Math.random() - 3.5 },
          };
          cursor = (cursor + 1) % maxParticles;
        }
        if (!running) requestAnimationFrame(animate);
      };

      const resize = () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      };
      window.addEventListener("resize", resize);
      document.body.addEventListener("input", emit);
      window.__selectionParticlesEmit = emit;
    }
  }
</script>
