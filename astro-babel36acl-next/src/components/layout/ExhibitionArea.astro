			</div>
			<a href="" target="_blank" rel="external nofollow" class="card-link">
				<div class="card-image">
					<img src="data:," alt="雪冴ゆる" loading="lazy" />
				</div>
				<div class="card-info">
					<p class="card-description">独りぽっちの冴えない僕を暗闇から連れ出してくれた</p>
				</div>
			</a>
		</div>
	</div>
</div>

<script is:inline>
	(() => {
		const initMedalEffects = () => {
			const cards = document.querySelectorAll(".medal-capsule");
			if (!cards.length) return;

			cards.forEach((card) => {
				if (card.dataset.medalEffectsInitialized === "true") return;
				const icon = card.querySelector("i");
				const content = card.querySelector(".capsule-content");
				const particles = card.querySelector(".medal-particles");
				if (!particles) return;

				const level = card.getAttribute("data-medal-level") || "bronze";
				const particleColor = level === "gold"
					? "rgba(255, 215, 0, 0.8)"
					: level === "silver"
						? "rgba(192, 192, 192, 0.8)"
						: "rgba(205, 127, 50, 0.8)";

				const particleCount = 10 + Math.floor(5 * Math.random());
				for (let index = 0; index < particleCount; index += 1) {
					const particle = document.createElement("span");
					particle.className = "medal-particle";
					Object.assign(particle.style, {
						position: "absolute",
						width: `${2 + 3 * Math.random()}px`,
						height: `${2 + 3 * Math.random()}px`,
						background: particleColor,
						borderRadius: "50%",
						opacity: String(0.3 + 0.7 * Math.random()),
						top: `${100 * Math.random()}%`,
						left: `${100 * Math.random()}%`,
						transition: `transform ${1.5 + 2 * Math.random()}s ease-out, opacity 1s ease-out`,
						pointerEvents: "none",
						boxShadow: `0 0 3px ${particleColor}`,
					});
					particles.appendChild(particle);

					card.addEventListener("mouseenter", () => {
						window.setTimeout(() => {
							Object.assign(particle.style, {
								transform: `translate3d(${40 * Math.random() - 20}px, ${40 * Math.random() - 20}px, 0)`,
								opacity: String(0.6 * Math.random()),
							});
						}, 100 * Math.random());
					});
					card.addEventListener("mouseleave", () => {
						window.setTimeout(() => {
							Object.assign(particle.style, {
								transform: "translate3d(0, 0, 0)",
								opacity: String(0.3 + 0.7 * Math.random()),
							});
						}, 100 * Math.random());
					});
				}

				card.style.transform = "perspective(1000px)";
				card.style.transformStyle = "preserve-3d";
				if (icon) icon.style.transform = "translateZ(5px)";
				if (content) content.style.transform = "translateZ(3px)";
				particles.style.transform = "translateZ(-5px)";

				card.addEventListener("mousemove", (event) => {
					const rect = card.getBoundingClientRect();
					const x = event.clientX - rect.left;
					const y = event.clientY - rect.top;
					const relativeX = (x - rect.width / 2) / (rect.width / 2);
					const relativeY = (y - rect.height / 2) / (rect.height / 2);
					card.style.transform = `perspective(1000px) rotateY(${5 * relativeX}deg) rotateX(${5 * -relativeY}deg) scale3d(1.05, 1.05, 1.05)`;
					if (icon) icon.style.transform = `translateX(${6 * relativeX}px) translateY(${4 * relativeY}px) translateZ(15px)`;
					if (content) content.style.transform = `translateX(${3 * relativeX}px) translateY(${2 * relativeY}px) translateZ(5px)`;
					particles.style.transform = `translateX(${2 * -relativeX}px) translateY(${2 * -relativeY}px) translateZ(-5px)`;
					card.dispatchEvent(new CustomEvent("medal:tilt", { detail: { relativeX, relativeY } }));
				});
				card.addEventListener("mouseleave", () => {
					card.style.transform = "perspective(1000px)";
					if (icon) icon.style.transform = "translateZ(5px)";
					if (content) content.style.transform = "translateZ(3px)";
					particles.style.transform = "translateZ(-5px)";
				});
				card.dataset.medalEffectsInitialized = "true";

				if (level === "gold" && !card.querySelector(".medal-ambient")) {
					const ambient = document.createElement("div");
					ambient.className = "medal-ambient";
					card.appendChild(ambient);
					for (const [index, position] of [["25%", "20%"], ["65%", "70%"]].entries()) {
						const fleck = document.createElement("div");
						fleck.className = `medal-fleck medal-fleck-${index + 1}`;
						fleck.style.top = position[0];
						fleck.style.left = position[1];
						card.appendChild(fleck);
					}
				}
			});
		};

		if (!window.__sakurairoMedalEffectsBound) {
			window.__sakurairoMedalEffectsBound = true;
			document.addEventListener("DOMContentLoaded", initMedalEffects, { once: true });
			document.addEventListener("astro:page-load", initMedalEffects);
			document.addEventListener("swup:contentReplaced", initMedalEffects);
		}
		initMedalEffects();
	})();
</script>
