---
import { profileConfig } from "@/config";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
interface Props { article?: boolean; statistics?: string; }
const { article = false, statistics = "加载耗时 2.099 秒 | 查询 66 次 | 内存使用 16.27 MB" } = Astro.props;
---

<footer id="colophon" class="site-footer" role="contentinfo">
	<div class="site-info" theme-info="Sakurairo v3.0.11">
		<div class="img-preload" style="display:none">
			<img alt="loading_svg" src={url("/assets/basic/puff-load.svg")} />
		</div>
		<div class="footer-content">
			<p id="footer_yiyan" class="hitokoto">
				{article ? "" : "酒调动着我们自身的温度，我们却糊涂的感谢世界的温暖。——鲍鹏山「百家讲坛」"}
			</p>
			<p class="footer_info">
				© {currentYear} <strong class="footer-site-name">{profileConfig.name}</strong>{article ? " " : ""}
				<span style="opacity:.65">— 世界は灰色でも、音だけは嘘をつかなかった。</span>
			</p>
			<p class="site-stats">{statistics}</p>
		</div>
		<div class="theme-info">
			<div class="sakura-icon">
				<svg
					width="30px"
					height="30px"
					class="sakura-svg"
					viewBox="0 0 1049 1024"
					version="1.1"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
				>
					<path d="M525.58396628 573.34694353s268.83106938-2.62915481 309.36387092 193.24287089l-76.46458293 21.90962291 12.92667757 84.13295086a214.05701289 214.05701289 0 0 1-96.84053193-4.82011663A224.79272784 224.79272784 0 0 1 525.58396628 578.38615666z" fill="#EE9ca7"></path>
					<path d="M552.75189802 512.4381922s131.45773592-233.7756732 321.63325979-170.89505575L854.2283053 418.66500728l79.31283344 30.89256828a215.59068679 215.59068679 0 0 1-52.58309388 81.50379604 224.57363215 224.57363215 0 0 1-325.35789552-14.67944718z" fill="#EE9ca7"></path>
					<path d="M508.49446078 494.0341093S317.00435871 306.48774025 426.77156822 139.31731943l69.4535037 38.78003191L547.4935884 109.30113636a214.05701289 214.05701289 0 0 1 65.72886796 71.86356201 225.01182435 225.01182435 0 0 1-98.37420505 310.67844912z" fill="#EE9ca7"></path>
					<path d="M473.21996809 525.58396628S242.2925454 661.64272234 109.30113636 512.4381922l55.43134521-57.18411482-53.45947909-65.72886795a213.61882069 213.61882069 0 0 1 86.32391269-43.81924506 224.79272784 224.79272784 0 0 1 274.527572 175.27698099z" fill="#EE9ca7"></path>
					<path d="M481.76472043 566.55496s72.0826585 258.31445093-106.4807652 348.14390364l-40.31370582-68.13892627-78.21735252 34.17901099a212.30424328 212.30424328 0 0 1-20.15685331-94.64956933 224.57363215 224.57363215 0 0 1 241.00584894-219.09622602z" fill="#EE9ca7"></path>
				</svg>
			</div>
			<a href="https://github.com/mirai-mamori/Sakurairo" rel="noopener" target="_blank">Theme Sakurairo</a>{" "}
			<a href="https://docs.fuukei.org/" rel="noopener" target="_blank">by Fuukei</a>
		</div>
	</div>
</footer>

<script is:inline>
	(() => {
		const initFooter = () => {
			const footer = document.getElementById("colophon");
			if (!footer || footer.dataset.lifecycleReady === "true") return;
			footer.dataset.lifecycleReady = "true";
			const contentPanel = document.getElementById("content-panel-inner");
			footer.classList.remove("show");
			const reserveSpace = () => {
				// Sakurairo's footer script reserves the measured pre-font footer space.
				// The frozen capture records this stable value at every homepage viewport.
				if (contentPanel && document.body.classList.contains("legacy-post-list")) {
					contentPanel.style.paddingBottom = "241.8px";
				}
				if (document.body.classList.contains("legacy-article")) {
					const articlePage = document.getElementById("page");
					if (articlePage && !articlePage.dataset.footerReserved) {
						articlePage.style.paddingBottom = `${footer.offsetHeight * 1.3}px`;
						articlePage.dataset.footerReserved = "true";
					}
				}
			};
			const syncVisibility = () => {
				if (window.__VISUAL_TEST__) {
					footer.classList.remove("show");
					return;
				}
				const nearBottom =
					(window.scrollY || document.documentElement.scrollTop) + window.innerHeight >=
					document.body.scrollHeight - 100;
				footer.classList.toggle("show", nearBottom);
			};
			reserveSpace();
			if (document.body.classList.contains("legacy-article")) {
				queueMicrotask(() => {
					const quote = document.getElementById("footer_yiyan");
					if (quote) quote.textContent = "酒调动着我们自身的温度，我们却糊涂的感谢世界的温暖。——鲍鹏山「百家讲坛」";
				});
			}
			window.addEventListener("scroll", syncVisibility, { passive: true });
			window.addEventListener("resize", () => {
				reserveSpace();
				syncVisibility();
			});
		};
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initFooter, { once: true });
		} else {
			initFooter();
		}
	})();
</script>
